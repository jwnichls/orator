# Copy to .env (git-ignored) for local development.

# Local sign-in without Google/Apple ("Continue as local developer"), as this email.
ALLOW_DEV_LOGIN=1
DEV_LOGIN_EMAIL=you@example.com

# Optional: real Google sign-in locally (redirect URI http://localhost:5173/api/auth/google/callback).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional one-time handover: the account with this email gets this key when it signs in.
# ANTHROPIC_KEY_OWNER_EMAIL=you@example.com
# ANTHROPIC_API_KEY=

# Local data lives in web/.data (PGlite). Set DATABASE_URL to use a real Postgres instead.
# DATABASE_URL=postgres://localhost/orator
